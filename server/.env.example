# Bind address (default 0.0.0.0:8080)
BIND=0.0.0.0:8080

# Database — scheme selects backend (sqlx Any):
#   sqlite:hmssh.db
#   sqlite:///absolute/path/hmssh.db
#   postgres://user:pass@localhost:5432/hmssh
#   mysql://user:pass@localhost:3306/hmssh
DATABASE_URL=sqlite:hmssh.db
# (server auto-appends ?mode=rwc for SQLite file creation)

# JWT signing secret (REQUIRED in production — use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Access token TTL seconds (default 86400 = 24h)
JWT_ACCESS_TTL_SECS=86400

# Optional refresh token TTL seconds (default 604800 = 7d)
JWT_REFRESH_TTL_SECS=604800

# Optional Redis — when set, session/profile cache uses Redis; otherwise in-memory (moka)
# REDIS_URL=redis://127.0.0.1:6379

# CORS: * (dev) or comma-separated origins for admin UI, e.g.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=*

# Optional path to TOML config (overrides defaults; env still wins over TOML)
# CONFIG_PATH=config.toml

# Auth register/login rate limit per IP per minute (default 20)
AUTH_RATE_LIMIT_PER_MIN=20

# Optional: seed first admin on startup if that email is missing (password min 8)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-admin-pass

# Max JSON body size in bytes (default 2097152 = 2 MiB)
# MAX_BODY_BYTES=2097152

# Max hosts entries accepted on PUT /sync/hosts (default 500)
# MAX_SYNC_HOSTS=500
